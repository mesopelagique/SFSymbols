
Case of 
	: (Form event code:C388=On Load:K2:1)
		// The complete SF Symbols list (Apple browse order, each tagged whether it has a real
		// multicolor variant) lives in Resources/symbols.json, regenerated by
		// Tools/generate_symbols.swift. Pictures are rendered lazily per visible row by the
		// Picture column's "symbolPicture" expression, so the full list loads instantly.
		Form:C1466.symbols:=JSON Parse:C1218(Folder:C1567(fk resources folder:K87:11).file("symbols.json").getText()).symbols
		
		
	: ((Form event code:C388=On Double Clicked:K2:5) | (Form event code:C388=On Alternative Click:K2:36))
		
		var $column; $row : Integer
		LISTBOX GET CELL POSITION:C971(*; "List Box"; $column; $row)
		
		If ($row>0)
			var $item : Object
			$item:=Form:C1466.symbols[$row-1]
			If ($item#Null:C1517)
				SET TEXT TO PASTEBOARD:C523(String:C10($item.name))
			End if 
		End if 
End case 